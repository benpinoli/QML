{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qftlab.local/schemas/hypothesis-tree-1.0.0.json",
  "title": "QFT QNN research hypothesis tree",
  "type": "object",
  "required": ["schema_version", "title", "scope", "status_vocabulary", "metric_conventions", "nodes"],
  "properties": {
    "schema_version": {"type": "string"},
    "title": {"type": "string"},
    "scope": {"type": "string"},
    "status_vocabulary": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "metric_conventions": {"type": "object", "additionalProperties": {"type": "string"}},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "parent_id", "title", "question", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "parent_id": {"type": ["string", "null"]},
          "title": {"type": "string"},
          "question": {"type": "string"},
          "status": {"enum": ["open", "supported", "not_supported", "planned", "completed"]},
          "observations": {"type": "array", "items": {"type": "string"}},
          "children": {"type": "array", "items": {"type": "string"}},
          "hypotheses": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
